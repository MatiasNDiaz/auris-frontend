# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media sin procesar
# Los originales pesados que llegan del centro se dejan en assets/raw/ y el
# pipeline (`npm run optimize:media`) los convierte a public/images y
# public/videos. Al repo solo va la salida optimizada. Se ignora el contenido
# pero no las carpetas —un .gitkeep en cada una, a cualquier profundidad—,
# para que después de clonar ya esté claro dónde se deja cada cosa.
/assets/raw/**
!/assets/raw/images/
!/assets/raw/videos/
!/assets/raw/images/**/
!/assets/raw/videos/**/
!/assets/raw/images/**/.gitkeep
!/assets/raw/videos/**/.gitkeep
